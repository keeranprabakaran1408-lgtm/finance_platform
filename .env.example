# Read-only database user for the AI assistant
ORACLE_READONLY_USER=
ORACLE_READONLY_PASSWORD=

# AWS
AWS_REGION=eu-west-2
S3_RAW_BUCKET=

# LLM provider for the AI assistant
LLM_API_KEY=
